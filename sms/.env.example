# Server-side (never expose secrets as NEXT_PUBLIC_*)
DATABASE_URL="postgresql://user:password@localhost:5432/sms_db"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me"

# Optional (only if using pre-signed uploads with AWS S3)
# If running on AWS with IAM roles, you may omit AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="your-bucket-name"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Pre-signed URL TTL (seconds). Keep this short (30-120s recommended)
S3_PRESIGN_TTL_SECONDS=60

# Max upload size enforced before issuing a pre-signed URL
UPLOAD_MAX_BYTES=10485760

